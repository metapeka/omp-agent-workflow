{
  "name": "omp-agent-workflow",
  "version": "0.3.0",
  "type": "module",
  "description": "Context guard, automatic handoff and Yoda workflow for OMP",
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "context",
    "compaction",
    "handoff"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types test/context-guard.test.mjs",
    "typecheck": "tsc --noEmit",
    "supervisor": "node bin/omp-handoff-supervisor.mjs"
  },
  "bin": {
    "omp-handoff-supervisor": "./bin/omp-handoff-supervisor.mjs",
    "omp-yoda": "./bin/omp-yoda"
  },
  "files": [
    "index.ts",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.1.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
