{
  "name": "omp-agent-workflow",
  "version": "0.5.15",
  "type": "module",
  "description": "Deterministic context guard, session handoff, and worktree orchestration for OMP (oh-my-pi)",
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "context",
    "compaction",
    "handoff",
    "session-management",
    "orchestration",
    "worktree",
    "supervisor"
  ],
  "homepage": "https://github.com/metapeka/omp-agent-workflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metapeka/omp-agent-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/metapeka/omp-agent-workflow/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "supervisor": "node bin/omp-handoff-supervisor.mjs",
    "orchestrate": "node --experimental-strip-types bin/omp-orchestrate"
  },
  "bin": {
    "omp-handoff-supervisor": "./bin/omp-handoff-supervisor.mjs",
    "omp-yoda": "./bin/omp-yoda",
    "omp-orchestrate": "./bin/omp-orchestrate"
  },
  "files": [
    "index.ts",
    "orchestrator.ts",
    "lib",
    "bin",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./index.ts",
      "./orchestrator.ts"
    ],
    "settings": {
      "workflowMode": {
        "type": "enum",
        "values": [
          "manual",
          "assisted",
          "yoda",
          "yoda-supervised"
        ],
        "default": "assisted",
        "env": "OMP_WORKFLOW_MODE",
        "description": "Режим workflow: manual — без авто-действий; assisted — авто-компакция; yoda — handoff 55%; yoda-supervised — handoff + внешний supervisor"
      },
      "statusEnabled": {
        "type": "boolean",
        "default": true,
        "env": "OMP_STATUS_ENABLED",
        "description": "Показывать ключ workflow в статус-строке: YODA/YODA-SUP и ⚠ HANDOFF; false — не публиковать"
      },
      "handoffAtPercent": {
        "type": "number",
        "min": 0,
        "max": 95,
        "step": 5,
        "env": "OMP_HANDOFF_AT",
        "description": "Порог HANDOFF, %: yoda/yoda-supervised — 55, иначе off; 0 = выключено"
      },
      "handoffCooldownSeconds": {
        "type": "number",
        "default": 300,
        "min": 0,
        "max": 86400,
        "step": 30,
        "env": "OMP_HANDOFF_COOLDOWN_SECONDS",
        "description": "Пауза после handoff, секунды; защита от цикла"
      },
      "contextWarnPercent": {
        "type": "number",
        "default": 35,
        "min": 1,
        "max": 99,
        "step": 5,
        "env": "OMP_CONTEXT_WARN",
        "description": "Порог предупреждения о контексте, %"
      },
      "contextSuggestPercent": {
        "type": "number",
        "default": 50,
        "min": 1,
        "max": 99,
        "step": 5,
        "env": "OMP_CONTEXT_SUGGEST",
        "description": "Порог предложения HANDOFF, %"
      },
      "autoCompactPercent": {
        "type": "number",
        "min": 0,
        "max": 100,
        "step": 5,
        "env": "OMP_CONTEXT_AUTO",
        "description": "Порог авто-компакции, %: assisted — 60, yoda* — 70, manual — off; 0 = выключено"
      },
      "orcaEnabled": {
        "type": "boolean",
        "default": true,
        "env": "OMP_ORCA_ENABLED",
        "description": "Использовать Orca: terminal list/show, /wrap live-терминалы и automatic handoff; false отключает supervisor и даёт git и /proc fallback"
      },
      "orcaPreflight": {
        "type": "boolean",
        "default": true,
        "env": "OMP_ORCA_PREFLIGHT",
        "description": "Проверять terminal handle через orca terminal show перед handoff"
      },
      "supervisorEnabled": {
        "type": "boolean",
        "default": true,
        "env": "OMP_SUPERVISOR_ENABLED",
        "description": "Запускать supervisor в bin/omp-yoda для automatic handoff"
      },
      "continuePrompt": {
        "type": "string",
        "default": "Прочитай HANDOFF.md и продолжи следующую задачу. Не начинай заново уже сделанное.",
        "env": "OMP_HANDOFF_PROMPT",
        "description": "Текст, который новая сессия получает после handoff"
      },
      "supervisorRetries": {
        "type": "number",
        "default": 3,
        "min": 1,
        "max": 10,
        "step": 1,
        "env": "OMP_SUPERVISOR_RETRIES",
        "description": "Попытки supervisor при send/preflight"
      },
      "supervisorLogLevel": {
        "type": "enum",
        "values": [
          "quiet",
          "info",
          "debug"
        ],
        "default": "info",
        "env": "OMP_SUPERVISOR_LOG_LEVEL",
        "description": "Логи supervisor: quiet — только ошибки, info — lifecycle, debug — подробно"
      }
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.1.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
