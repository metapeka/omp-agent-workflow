#!/usr/bin/env bash
# Yoda workflow launcher: OMP + context guard + handoff supervisor.
#
# Запускает supervisor на текущий каталог и OMP с режимом yoda-supervised.
# Supervisor живёт столько же, сколько OMP: снимается по EXIT/INT/TERM.
# Настройки — Settings > Plugins (omp.settings); env остаётся fallback.
set -u

script="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$script")"
supervisor="$here/omp-handoff-supervisor.mjs"
dir="${OMP_YODA_DIR:-$PWD}"
log="${OMP_YODA_LOG:-${TMPDIR:-/tmp}/omp-yoda-supervisor.log}"

if ! command -v omp >/dev/null 2>&1; then
  echo "omp-yoda: omp not found in PATH" >&2
  exit 127
fi
omp_bin="$(command -v omp)"

if [ ! -f "$supervisor" ]; then
  echo "omp-yoda: supervisor not found: $supervisor" >&2
  exit 1
fi

# Явные настройки плагина (без manifest-дефолтов); один вызов на запуск.
settings_json="$("$omp_bin" plugin config list omp-agent-workflow --json 2>/dev/null)"
plugin_setting() {
  printf '%s' "$settings_json" |
    node -e 'let d="";process.stdin.on("data",(c)=>{d+=c});process.stdin.on("end",()=>{try{const o=JSON.parse(d);const s=o.settings||{};const v=s[process.argv[1]];if(v!==undefined&&v!==null)process.stdout.write(String(v))}catch{}})' "$1"
}

supervisor_setting="$(plugin_setting supervisorEnabled)"
orca_enabled_setting="$(plugin_setting orcaEnabled)"
orca_preflight_setting="$(plugin_setting orcaPreflight)"
orca_cli_setting="$(plugin_setting orcaCli)"
continue_prompt_setting="$(plugin_setting continuePrompt)"
supervisor_retries_setting="$(plugin_setting supervisorRetries)"
supervisor_log_setting="$(plugin_setting supervisorLogLevel)"

# Kill switch: off — OMP как есть, без supervisor и без наших порогов.
# env `off` побеждает Settings, чтобы выключение работало в аварии.
mode_setting="$(plugin_setting workflowMode)"
if [ "${OMP_WORKFLOW_MODE:-}" = "off" ]; then
  mode_value="off"
else
  mode_value="${mode_setting:-${OMP_WORKFLOW_MODE:-assisted}}"
fi
if [ "$mode_value" = "off" ]; then
  echo "Yoda: off — дефолты OMP, supervisor не запускается" >&2
  OMP_WORKFLOW_MODE=off exec "$omp_bin" "$@"
fi

# Advisory `next-session:` из HANDOFF.md: launcher добавляет --model/--thinking,
# только если пользователь не передал их сам. Невалидная или устаревшая строка
# ничего не меняет; модель уже проверена по `omp models --json`.
advisory_args=()
if [ -f "$dir/HANDOFF.md" ] && [ -f "$here/omp-next-session" ]; then
  advisory_out="$(node --experimental-strip-types --disable-warning=ExperimentalWarning \
    "$here/omp-next-session" --dir "$dir" --omp "$omp_bin" -- "$@" 2>/dev/null)" || advisory_out=""
  if [ -n "$advisory_out" ]; then
    set -f
    # shellcheck disable=SC2206
    advisory_args=($advisory_out)
    set +f
    echo "Yoda: next-session → ${advisory_args[*]}" >&2
  fi
fi

# Settings > env > default.
supervisor_value="${supervisor_setting:-${OMP_SUPERVISOR_ENABLED:-true}}"
orca_enabled_value="${orca_enabled_setting:-${OMP_ORCA_ENABLED:-true}}"
orca_preflight_value="${orca_preflight_setting:-${OMP_ORCA_PREFLIGHT:-true}}"
orca_cli="${orca_cli_setting:-${ORCA_CLI_COMMAND:-orca}}"

if [ -n "$orca_cli_setting" ]; then
  export ORCA_CLI_COMMAND="$orca_cli_setting"
fi

continue_prompt_value="${continue_prompt_setting:-${OMP_HANDOFF_PROMPT:-}}"
supervisor_retries_value="${supervisor_retries_setting:-${OMP_SUPERVISOR_RETRIES:-}}"
supervisor_log_value="${supervisor_log_setting:-${OMP_SUPERVISOR_LOG_LEVEL:-}}"
if [ -n "$continue_prompt_value" ]; then
  export OMP_HANDOFF_PROMPT="$continue_prompt_value"
fi
if [ -n "$supervisor_retries_value" ]; then
  export OMP_SUPERVISOR_RETRIES="$supervisor_retries_value"
fi
if [ -n "$supervisor_log_value" ]; then
  export OMP_SUPERVISOR_LOG_LEVEL="$supervisor_log_value"
fi

is_false() {
  case "$1" in
    0 | false | off | no) return 0 ;;
  esac
  return 1
}

start_supervisor=1
if is_false "$supervisor_value" || is_false "$orca_enabled_value"; then
  start_supervisor=0
fi

if [ "$start_supervisor" = "1" ] && command -v "$orca_cli" >/dev/null 2>&1; then
  if ! "$orca_cli" status >/dev/null 2>&1; then
    echo "Yoda: orca runtime недоступен — automatic handoff не сработает" >&2
  fi
fi

sup=""
if [ "$start_supervisor" = "1" ]; then
  OMP_ORCA_ENABLED="$orca_enabled_value" \
  OMP_ORCA_PREFLIGHT="$orca_preflight_value" \
  OMP_SUPERVISOR_ENABLED="$supervisor_value" \
  node "$supervisor" --dir "$dir" >"$log" 2>&1 &
  sup=$!
  echo "Yoda: supervisor pid=$sup log=$log dir=$dir"
else
  echo "Yoda: supervisor отключён настройками (supervisorEnabled/orcaEnabled)" >&2
fi

cleanup() {
  if [ -n "$sup" ]; then
    kill "$sup" 2>/dev/null || true
    wait "$sup" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

OMP_WORKFLOW_MODE="${OMP_WORKFLOW_MODE:-yoda-supervised}" \
OMP_HANDOFF_AT="${OMP_HANDOFF_AT:-55}" \
OMP_CONTEXT_AUTO="${OMP_CONTEXT_AUTO:-off}" \
"$omp_bin" "${advisory_args[@]}" "$@"
status=$?

cleanup
trap - EXIT INT TERM
exit "$status"
