#!/usr/bin/env node
/**
 * Entrypoint shim: the CLI body lives in `lib/cli/orchestrate.ts` and is loaded
 * through `lib/ts-loader.mjs`, so the script runs from a clone, an unpacked
 * tarball and a `node_modules` install alike.
 */
import { register } from "node:module";

register(new URL("../lib/ts-loader.mjs", import.meta.url));
await import("../lib/cli/orchestrate.ts");
